set version 21.4R3-S3.4
set system host-name SRX-BRANCH-01
set system root-authentication encrypted-password "$6$salt$HardRootHashValue"
set system login user admin class super-user
set system login user admin authentication encrypted-password "$6$salt$HardAdminHashValue"
set system services ssh protocol-version v2
set system ntp server 10.10.10.1
set system ntp server 10.10.10.2
set system syslog host 10.10.20.9 any info
set interfaces ge-0/0/0 unit 0 family inet address 203.0.113.20/30
